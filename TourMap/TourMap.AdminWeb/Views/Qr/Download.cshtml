@model TourMap.AdminWeb.Controllers.QrDownloadPageViewModel

@{
    ViewData["Title"] = "Tải Ứng Dụng";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Tải TourMap Audio Guide</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        .download-container {
            max-width: 420px;
            margin: 0 auto;
            padding: 20px;
        }
        .app-icon {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, #0d7a5f, #128c6e);
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            box-shadow: 0 10px 30px rgba(13, 122, 95, 0.3);
        }
        .app-icon i {
            font-size: 48px;
            color: white;
        }
        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        .btn-download {
            background: linear-gradient(135deg, #0d7a5f, #128c6e);
            border: none;
            border-radius: 16px;
            padding: 16px 32px;
            font-size: 18px;
            font-weight: 600;
            box-shadow: 0 8px 20px rgba(13, 122, 95, 0.3);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-download:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(13, 122, 95, 0.4);
        }
        .btn-download:active {
            transform: translateY(0);
        }
        .expiry-badge {
            background: #fff3cd;
            border: 1px solid #ffc107;
            border-radius: 12px;
            padding: 12px 16px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .feature-list {
            text-align: left;
            margin: 20px 0;
        }
        .feature-list li {
            padding: 8px 0;
            color: #6c757d;
        }
        .feature-list i {
            color: #0d7a5f;
            margin-right: 8px;
        }
    </style>
</head>
<body class="d-flex align-items-center">
    <div class="download-container w-100">
        <div class="card p-4">
            <!-- App Icon -->
            <div class="app-icon">
                <i class="bi bi-headphones"></i>
            </div>

            <!-- App Name -->
            <h2 class="text-center fw-bold mb-2">@Model.AppName</h2>
            <p class="text-muted text-center mb-4">Audio Tour Guide - Phố Ẩm Thực Vĩnh Khánh</p>

            <!-- Features -->
            <ul class="feature-list list-unstyled">
                <li><i class="bi bi-geo-alt-fill"></i>Thuyết minh tự động theo vị trí</li>
                <li><i class="bi bi-headphones"></i>Audio chất lượng cao</li>
                <li><i class="bi bi-map-fill"></i>Bản đồ 10 địa điểm ẩm thực</li>
                <li><i class="bi bi-wifi-off"></i>Hoạt động offline</li>
            </ul>

            <!-- Expiry Info -->
            <div class="text-center mb-4">
                <div class="expiry-badge">
                    <i class="bi bi-clock text-warning"></i>
                    <span>Mã QR còn hiệu lực: <strong>@Model.RemainingMinutes phút</strong></span>
                </div>
            </div>

            <!-- Download Button -->
            <a href="@Model.ApkUrl" class="btn btn-success btn-download w-100" download>
                <i class="bi bi-download me-2"></i>Tải APK Ngay
            </a>

            <!-- Install Instructions -->
            <div class="mt-4 p-3 bg-light rounded-3 text-start small">
                <p class="fw-semibold mb-2"><i class="bi bi-info-circle me-2 text-primary"></i>Hướng dẫn cài đặt:</p>
                <ol class="ps-3 mb-0 text-muted">
                    <li>Tải file APK xuống</li>
                    <li>Mở file vừa tải</li>
                    <li>Cho phép "Cài đặt từ nguồn không xác định"</li>
                    <li>Cài đặt và mở ứng dụng</li>
                </ol>
            </div>

            <!-- Footer -->
            <p class="text-center text-muted small mt-4 mb-0">
                <i class="bi bi-shield-check me-1"></i>
                Mã QR hết hạn lúc: @Model.ExpiresAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
